import { SwissComponent } from '@kibologic/core';

component Toast {
  props = {
    message: String,
    type: String,
    duration: Number,
    onclose: Function as () => void,
  };

  state { let visible: boolean = true; }

  mounted() {
    const duration = this.props.duration || 3000;
    if (duration > 0) {
      setTimeout(() => {
        this.close();
      }, duration);
    }
  }

  close() {
    this.visible = false;
    if (this.props.onclose) {
      setTimeout(() => this.props.onclose(), 300);
    }
  }

  getIcon() {
    switch (this.props.type) {
      case 'success': return '✓';
      case 'error':   return '✕';
      case 'warning': return '⚠';
      default:        return 'ⓘ';
    }
  }

  render() {
    if (!this.visible) return null;

    const type = this.props.type || 'info';

    return (
      <div class="aui-toast-container">
        <div class={`aui-toast aui-toast--${type}`}>
          <div style="display:flex;align-items:center;gap:0.75rem;">
            <span>{this.getIcon()}</span>
            <span>{this.props.message}</span>
          </div>
          <button
            type="button"
            onclick={() => this.close()}
            style="background:none;border:none;color:inherit;cursor:pointer;"
          >✕</button>
        </div>
      </div>
    );
  }
}
