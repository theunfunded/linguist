import { SwissComponent } from '@kibologic/core';

component StatusBadge {
  props = {
    label: String,
    type: String,
  };

  render() {
    const type = this.props.type || 'neutral';

    return (
      <span class={`alp-badge alp-badge--${type}`}>
        {this.props.label}
      </span>
    );
  }
}
